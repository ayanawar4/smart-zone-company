{
  "buildCommand": "cd client && npm install && npm run build && cd .. && npm install",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": {
      "memory": 512,
      "maxDuration": 10
    }
  },
  "env": {
    "VERCEL": "1"
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
